<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Usuários</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Fundo */
        body {
            min-height: 100vh;

            background: linear-gradient(
                135deg,
                #ffe4ef,
                #ffc1d9,
                #ffb0d0
            );

            font-family: Arial, sans-serif;

            padding: 30px;
        }

        /* Título */
        h1 {
            text-align: center;

            color: #c2185b;

            font-family: cursive;

            font-size: 38px;

            margin-bottom: 25px;
        }

        /* Menu */
        .menu {
            display: flex;

            justify-content: center;

            gap: 20px;

            margin-bottom: 35px;
        }

        .menu a {
            text-decoration: none;

            background-color: #e91e63;

            color: white;

            padding: 12px 22px;

            border-radius: 25px;

            font-weight: bold;

            transition: 0.3s;
        }

        /* Efeito dos botões */
        .menu a:hover {
            background-color: #ad1457;

            transform: translateY(-2px);

            box-shadow:
                0 5px 12px rgba(173, 20, 87, 0.3);
        }

        /* Área dos cards */
        #divPrincipal {
            width: 100%;

            max-width: 1100px;

            margin: 0 auto;

            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(280px, 1fr));

            gap: 25px;
        }

        /* Remove a numeração da lista */
        #divPrincipal li {
            list-style: none;
        }

        /* Card do usuário */
        .card-usuario {
            background-color: white;

            padding: 25px;

            border-radius: 20px;

            border: 2px solid #f48ab5;

            box-shadow:
                0 8px 20px rgba(194, 24, 91, 0.18);

            transition: 0.3s;
        }

        /* Efeito ao passar o mouse */
        .card-usuario:hover {
            transform: translateY(-5px);

            box-shadow:
                0 12px 25px rgba(194, 24, 91, 0.30);
        }

        /* Identificação do card */
        .usuario-titulo {
            display: inline-block;

            background-color: #fce4ec;

            color: #c2185b;

            padding: 6px 12px;

            border-radius: 15px;

            font-size: 13px;

            font-weight: bold;

            margin-bottom: 15px;
        }

        /* Nome */
        .card-usuario h2 {
            color: #c2185b;

            font-size: 22px;

            margin-bottom: 15px;
        }

        /* Informações */
        .card-usuario p {
            color: #6d2145;

            font-size: 16px;

            margin: 9px 0;

            text-align: left;
        }

        /* Destaque das informações */
        .info {
            color: #e91e63;

            font-weight: bold;
        }

        /* Responsividade */
        @media (max-width: 600px) {

            body {
                padding: 20px;
            }

            h1 {
                font-size: 30px;
            }

            .menu {
                flex-direction: column;

                align-items: center;
            }

            .menu a {
                width: 100%;

                text-align: center;
            }
        }
    </style>
</head>

<body>

    <h1>Usuários</h1>

    <div class="menu">

        <a href="/cadastrousuario">
            Cadastrar Usuário
        </a>

        <a href="/">
            Home
        </a>

    </div>

    <div id="divPrincipal">

        {{#each usuario}}

            <li>

                <div class="card-usuario">

                    <span class="usuario-titulo">
                        Usuário
                    </span>

                    <h2>
                        {{this.nome}}
                    </h2>

                    <p>
                        <span class="info">Email:</span>
                        {{this.email}}
                    </p>

                    <p>
                        <span class="info">Telefone:</span>
                        {{this.telefone}}
                    </p>

                </div>

            </li>

        {{/each}}

    </div>

</body>

</html>
