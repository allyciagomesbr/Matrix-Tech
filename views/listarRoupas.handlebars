<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Roupas Disponíveis</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(
                135deg,
                #ffe4ef,
                #ffc1d9,
                #ffb0d0
            );

            min-height: 100vh;

            font-family: Arial, sans-serif;

            padding-bottom: 50px;
        }

        /* Cabeçalho */
        .topo-loja {

            position: relative;

            background-color: #c23262;

            padding: 25px;

            text-align: center;

            color: white;

            box-shadow:
                0 3px 10px rgba(0, 0, 0, 0.2);
        }

        .topo-loja h1 {
            font-size: 32px;

            font-family: cursive;
        }

        .topo-loja .carrinho {
            position: absolute;
            right: 20px;    
            top: 50%;        
            transform: translateY(-50%);
            font-size: 24px; 
            cursor: pointer;
        }

        /* Menu */
        .menu {
            display: flex;

            justify-content: center;

            gap: 15px;

            margin: 30px auto;

            flex-wrap: wrap;
        }

        .menu a {
            background-color: #c2185b;

            color: white;

            text-decoration: none;

            padding: 12px 20px;

            border-radius: 25px;

            font-weight: bold;

            transition: 0.3s;
        }

        .menu a:hover {
            background-color: #ad1457;

            transform: translateY(-2px);

            box-shadow:
                0 5px 12px rgba(173, 20, 87, 0.3);
        }

        /* Área dos cards */
        #divPrincipal {
            width: 70%;

            max-width: 900px;

            margin: 0 auto;

            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(250px, 1fr));

            gap: 25px;
        }

        /* Card da roupa */
        .card {
            background-color: white;

            border-radius: 20px;

            padding: 20px;

            text-align: center;
            font-weight: bold;

            box-shadow:
                0 6px 18px rgba(194, 24, 91, 0.20);

            border: 2px solid #f48ab5;

            transition: 0.3s;

            overflow: hidden;
        }

        .card:hover {
            transform: translateY(-7px);

            box-shadow:
                0 10px 25px rgba(194, 24, 91, 0.30);
        }

        
        .card img {
            width: 80%;

            height: 50%;

            object-fit: cover;

            border-radius: 15px;

            margin-bottom: 15px;

            border: 2px solid #f48ab5;
        }

        
        .sem-imagem {
            width: 100%;

            height: 220px;

            background-color: #fce4ec;

            border-radius: 15px;

            display: flex;

            justify-content: center;

            align-items: center;

            color: #c2185b;

            font-weight: bold;

            margin-bottom: 15px;
        }

        
        .card h2 {
            color: #c2185b;

            font-size: 23px;

            font-weight: bold;

            margin-bottom: 12px;
        }

        
        .card p {
            color:  #ad1649;

            font-size: 18px;

            font-weight: bold;

            margin: 8px 0;
        }

        .info {
            color: #ad1649;

        
        }

        /* Valor */
        .valor {
            color: #c2185b !important;

            font-size: 20px !important;

            font-weight: bold;

            margin-top: 15px !important;
        }

        /* Botões */
        .botoes {
            margin-top: 20px;

            display: flex;

            justify-content: center;

            gap: 10px;
        }

        .botoes a,
        .botoes button {
            border: none;

            text-decoration: none;

            padding: 9px 15px;

            border-radius: 8px;

            color: rgb(245, 242, 243);

            font-weight: bold;

            cursor: pointer;

            font-size: 16px;
        }

        
        .editar {
            background-color: #ad1457;
        }

        .editar:hover {
            background-color: #ad1457;
        }

        
        .excluir {
            background-color: #630606;
        }

        .excluir:hover {
            background-color: #630606;
        } 

       
        .form-excluir {
            display: inline;
        }

        
        .sem-roupas {
            grid-column: 1 / -1;

            text-align: center;

            background-color: white;

            padding: 40px;

            border-radius: 20px;

            color: #c2185b;

            font-size: 20px;

            box-shadow:
                0 6px 18px rgba(194, 24, 91, 0.20);
        }

        .carrinho{
           background-color: #c2185b; 
        }

        /* Celular */
        @media (max-width: 600px) {

            .topo-loja h1 {
                font-size: 27px;
            }

            #divPrincipal {
                width: 95%;
            }

            .card img,
            .sem-imagem {
                height: 200px;
            }

            
        .carrinho {
            background-color: #af4c91;
        }

        .carrinho:hover {
            background-color: #af4c91;
        }

        }

    </style>
</head>

<body>

    <header class="topo-loja">
        <h1>Roupas Disponíveis</h1>
    </header>

    <nav class="menu">

        <a href="/roupas/cadastrar">
            Cadastrar Roupa
        </a>

        <a href="/">
            Home
        </a>

        <a href="/carrinho">
        🛒 Meu Carrinho
    </a>

    </nav>

    <main id="divPrincipal">

        {{#if roupas}}

            {{#each roupas}}

                <div class="card">

                    {{#if this.imagem}}

                        <img
                            src="{{this.imagem}}"
                            alt="{{this.peca}}"
                        >

                    {{else}}

                        <div class="sem-imagem">
                            Sem imagem
                        </div>

                    {{/if}}

                    <h2>
                        {{this.peca}}
                    </h2>

                    <p>
                        <span class="info">
                            Tecido:
                        </span>

                        {{this.tecido}}
                    </p>

                    <p class="valor">
                        R$ {{this.valor}}
                    </p>

                    

                       <div class="botoes">

    <a
        class="editar"
        href="/roupas/{{this.id}}/editar"
    >
        Editar
    </a>

    <form
        class="form-excluir"
        action="/roupas/excluir/{{this.id}}"
        method="post"
    >
        <button
            class="excluir"
            type="submit"
        >
            Excluir
        </button>
    </form>

    <form
        action="/carrinho/adicionar"
        method="POST"
    >
        <input
            type="hidden"
            name="roupaId"
            value="{{this.id}}"
        >

        <button
            type="submit"
            class="carrinho"
        >
            🛒 Adicionar
        </button>
    </form>

</div>


                        </form>

                    </div>

                </div>

            {{/each}}

        {{else}}

            <div class="sem-roupas">
                Nenhuma roupa cadastrada.
            </div>

        {{/if}}

    </main>

</body>

</html>
