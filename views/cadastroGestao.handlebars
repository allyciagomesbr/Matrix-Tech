<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cadastro de Administradores</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #ffe4f0, #ffc1dc, #ffb0d0);
            min-height: 100vh;
            font-family: Arial, sans-serif;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Card principal */
        #divPrincipal {
            background-color: #ffffff;
            width: 420px;
            padding: 35px;
            border-radius: 25px;

            box-shadow: 0 10px 30px rgba(190, 30, 100, 0.25);

            border: 2px solid #f48ab5;
        }

        /* Título */
        h1 {
            text-align: center;
            color: #c2185b;
            font-size: 30px;
            margin-bottom: 10px;
            font-family: cursive;
        }

        /* Subtítulo */
        h3 {
            text-align: center;
            color: #8e3158;
            margin-bottom: 25px;
        }

        /* Formulário */
        form {
            display: flex;
            flex-direction: column;
        }

        /* Labels */
        label {
            color: #9c1450;
            font-weight: bold;
            margin-bottom: 7px;
        }

        /* Campos */
        input {
            width: 100%;
            padding: 13px 15px;

            border: 2px solid #f3a1c0;
            border-radius: 12px;

            background-color: #fff5f9;
            color: #5c1635;

            font-size: 15px;
            outline: none;

            transition: 0.3s;
        }

        /* Efeito ao clicar no campo */
        input:focus {
            border-color: #e91e63;
            background-color: #ffffff;

            box-shadow: 0 0 8px rgba(233, 30, 99, 0.25);
        }

        /* Espaçamento entre os campos */
        .campo {
            margin-bottom: 18px;
        }

        /* Botão */
        button {
            margin-top: 10px;

            padding: 14px;

            border: none;
            border-radius: 12px;

            background: linear-gradient(135deg, #e91e63, #c2185b);
            color: white;

            font-size: 17px;
            font-weight: bold;

            cursor: pointer;

            transition: 0.3s;
        }

        /* Efeito do botão */
        button:hover {
            background: linear-gradient(135deg, #c2185b, #ad1457);

            transform: translateY(-2px);

            box-shadow: 0 5px 15px rgba(194, 24, 91, 0.35);
        }

        button:active {
            transform: scale(0.98);
        }

        /* Texto */
        p {
            text-align: center;
            color: #8e3158;
            margin-bottom: 20px;
        }
    </style>
</head>

<body>

    <div id="divPrincipal">

        <h1>Cadastrar Gestão</h1>

        <p>Preencha os dados para realizar o cadastro</p>

        <form action="/gestao/cadastro" method="post">

            <div class="campo">
                <label for="iptEmail">Email</label>
                <input 
                    type="email" 
                    id="iptEmail" 
                    name="email" 
                    placeholder="Digite seu email"
                    required>
            </div>

            <div class="campo">
                <label for="iptTelefone">Telefone</label>
                <input 
                    type="tel" 
                    id="iptTelefone" 
                    name="telefone" 
                    placeholder="Digite seu telefone"
                    required>
            </div>

            <div class="campo">
                <label for="iptNome">Nome</label>
                <input 
                    type="text" 
                    id="iptNome" 
                    name="nome" 
                    placeholder="Digite seu nome"
                    required>
            </div>

            <div class="campo">
                <label for="iptIdade">Idade</label>
                <input 
                    type="number" 
                    id="iptIdade" 
                    name="idade" 
                    placeholder="Digite sua idade"
                    required>
            </div>

            <button type="submit">
                Cadastrar
            </button>

        </form>

    </div>

</body>
</html>
