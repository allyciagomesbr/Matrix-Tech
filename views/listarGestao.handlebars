<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Administradores</title>


<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(135deg, #ffe4ef, #ffc1d9);
        min-height: 100vh;
        font-family: Arial, sans-serif;
        padding: 30px;
    }

   
    h1 {
        text-align: center;
        color: #c2185b;
        font-family: cursive;
        font-size: 35px;
        margin-bottom: 25px;
    }


    .menu {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 35px;
    }

    .menu a {
        text-decoration: none;
        background-color: #ad1457;
        color: white;

        padding: 12px 20px;
        border-radius: 25px;

        font-weight: bold;

        transition: 0.3s;
    }

    .menu a:hover {
        background-color: #ad1457;
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(173, 20, 87, 0.3);
    }

   
    #divPrincipal {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;

        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px;
    }

    /* Remove o estilo padrão da lista */
    #divPrincipal ol,
    #divPrincipal ul {
        list-style: none;
    }

   
    .card-admin {
        background-color: white;

        padding: 25px;

        border-radius: 20px;

        border: 2px solid #880a3c;

        box-shadow: 0 8px 20px rgba(194, 24, 91, 0.18);

        transition: 0.3s;
    }

   
    .card-admin:hover {
        transform: translateY(-5px);

        box-shadow: 0 12px 25px rgba(194, 24, 91, 0.3);
    }

   
    .card-admin h2 {
        color: #c2185b;
        font-size: 21px;
        margin-bottom: 12px;
    }

 
    .card-admin p {
        color: #6d2145;
        font-size: 18px;
        margin: 8px 0;
    }

   
    .info {
        color: #c2185b;
        font-weight: bold;
    }

    
    .numero {
        display: inline-block;

        background-color: #fce4ec;
        color: #c2185b;

        padding: 6px 12px;

        border-radius: 15px;

        font-size: 16px;
        font-weight: bold;

        margin-bottom: 15px;
    }

    
    @media (max-width: 600px) {
        body {
            padding: 20px;
        }

        h1 {
            font-size: 28px;
        }

        .menu {
            flex-direction: column;
            align-items: center;
        }

        .menu a {
            width: 100%;
            text-align: center;
        }
    }
</style>

</head>

<body>

    <h1>Lista de Administradores</h1>

    <div class="menu">
        <a href="/gestao/cadastro">
            Cadastrar Novos Administradores
        </a>

        <a href="/">
            Home
        </a>
    </div>

    <div id="divPrincipal">

        {{#each gestao}}

            <div class="card-admin">

                <span class="numero">
                    Administrador
                </span>

                <h2>
                    {{this.nome}}
                </h2>

                <p>
                    <span class="info">Email:</span>
                    {{this.email}}
                </p>

                <p>
                    <span class="info">Telefone:</span>
                    {{this.telefone}}
                </p>

                <p>
                    <span class="info">Idade:</span>
                    {{this.idade}}
                </p>

            </div>

        {{/each}}

    </div>

</body>
</html>
